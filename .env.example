# Copy to ".env" in this folder (never commit .env). Restart Expo after changes.

# --- VideoSDK calls & live streams (required for production builds) ---
# Option A — Appwrite Function "videosdk-token" (see appwrite-functions/videosdk-token/).
# In Appwrite Console: Functions → videosdk-token → copy the HTTPS domain (…appwrite.run).
EXPO_PUBLIC_VIDEOSDK_TOKEN_URL=https://xxxxxxxxxxxx.appwrite.run

# Option B — Same Node server as video processing (server/server.js exposes GET /get-token).
# EXPO_PUBLIC_SERVER_URL=https://your-api.example.com
# EXPO_PUBLIC_PROCESSING_SERVER_URL=http://192.168.1.10:3001
# Optional dedicated room creation backend URL. Useful when token URL points to Appwrite function.
# EXPO_PUBLIC_VIDEOSDK_ROOM_URL=http://192.168.1.10:3001
# Optional room endpoint path on the same server (defaults to /create-room on non-appwrite hosts).
# EXPO_PUBLIC_VIDEOSDK_ROOM_PATH=/create-room

# Optional: path override. Omit for defaults (root query for *.appwrite.run, /get-token otherwise).
# EXPO_PUBLIC_VIDEOSDK_TOKEN_PATH=

# Optional public VideoSDK API key (dashboard); app has a fallback if unset.
# Required when the app creates rooms directly via POST https://api.videosdk.live/v2/rooms
# EXPO_PUBLIC_VIDEOSDK_API_KEY=

# Keep debug LOG button on TestFlight (default on). Set to 0 only for final App Store release.
# EXPO_PUBLIC_VIDEOSDK_DEBUG_LOGS=1

# --- EAS / store builds ---
# Add the same EXPO_PUBLIC_VIDEOSDK_TOKEN_URL in Expo dashboard → Project → Environment variables
# or: npx eas secret:create --scope project --name EXPO_PUBLIC_VIDEOSDK_TOKEN_URL --value "https://…"
# Then run: eas build --profile production

# --- Push notifications (DMs, follows, posts, live, admin) ---
# Prefer the Node server so expoPushToken is read with APPWRITE_API_KEY (same path as working DMs).
# EXPO_PUBLIC_PROCESSING_SERVER_URL=http://192.168.1.10:3001
# EXPO_PUBLIC_PUSH_RELAY_URL=http://192.168.1.10:3001/api/push/send
# EXPO_PUBLIC_ADMIN_BROADCAST_URL=http://192.168.1.10:3001/api/admin/broadcast-content
# EXPO_PUBLIC_CREATOR_NOTIFY_URL=http://192.168.1.10:3001/api/creator/notify-content

# --- CEO broadcast (optional) ---
# When this account posts video/photo or goes live, ALL users get notified.
# EXPO_PUBLIC_CEO_USER_IDS=your_appwrite_user_id
# EXPO_PUBLIC_CEO_EMAILS=randydillon97@gmail.com
# EXPO_PUBLIC_ADMIN_EMAILS=you@example.com

# --- Stripe payments (donations, ads, paid live streams) ---
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Paid streams: deploy appwrite-functions/stream-access/ then set:
# EXPO_PUBLIC_PROCESSING_SERVER_URL=https://YOUR_STREAM_ACCESS_FUNCTION.nyc.appwrite.run
# Function env: STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, APPWRITE_DATABASE_ID, APPWRITE_API_KEY,
#   APPWRITE_LIVE_STREAMS_COLLECTION_ID, APPWRITE_STREAM_PURCHASES_COLLECTION_ID
# Stripe Dashboard → Webhooks → https://YOUR_FUNCTION.nyc.appwrite.run/api/stripe-webhook
#   Events: payment_intent.succeeded, payment_intent.payment_failed
# QA: node scripts/verify-paid-stream-qa.cjs

# Paid live streaming — after creating streamPurchases collection in Appwrite:
# EXPO_PUBLIC_STREAM_PURCHASES_COLLECTION_ID=your_collection_id
# Server-side schema verify: APPWRITE_API_KEY=... node scripts/verify-paid-stream-schema.cjs

# --- Friends Live Location (maps) ---
# Android needs this for Google Map tiles. iOS can use Apple Maps without a key.
# Enable Maps SDK for Android in Google Cloud, restrict key to package com.bilal.asab.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
