{
  "expo": {
    "name": "ASAB",
    "slug": "asab",
    "version": "1.1.5",
    "orientation": "portrait",
    "icon": "./assets/images/asabicon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#000000",
      "resizeMode": "cover"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/images/asabicon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.bilal.asab",
      "displayName": "ASAB",
      "infoPlist": {
        "CFBundleDisplayName": "ASAB",
        "CFBundleName": "ASAB",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.bilal.asab"
            ]
          }
        ],
        "NSCameraUsageDescription": "This app needs access to camera for video calls and recording videos",
        "NSMicrophoneUsageDescription": "This app needs access to microphone for audio calls and video recording",
        "NSPhotoLibraryUsageDescription": "This app needs access to photo library to select and upload videos",
        "NSLocalNetworkUsageDescription": "This app needs access to local network for real-time communication",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIViewControllerBasedStatusBarAppearance": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/images/asabicon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/asabicon.png",
        "backgroundColor": "#000000",
        "monochromeImage": "./assets/images/asabicon.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.WAKE_LOCK",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "package": "com.bilal.asab"
    },
    "web": {
      "favicon": "./assets/images/asabicon.png"
    },
    "scheme": "com.bilal.asab",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "android": {
            "backgroundColor": "#000000"
          },
          "ios": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-router",
      "expo-font",
      "expo-video",
      "expo-web-browser",
      "expo-camera",
      "@videosdk.live/expo-config-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow camera access",
          "microphonePermission": "Allow microphone access"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "ndkVersion": "27.0.12077973"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/asabicon.png",
          "color": "#ffffff",
          "sounds": []
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "router": {},
      "videosdkDebugLogs": false,
      "videosdkTokenBaseUrl": "",
      "videosdkRoomBaseUrl": "",
      "eas": {
        "projectId": "ce1f375b-6f7c-42c7-ae65-7d6b98ece5e8"
      }
    }
  }
}
